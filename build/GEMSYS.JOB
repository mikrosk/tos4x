# MultiTOS 1.00 GEM.SYS in the six languages of its resources, run by C:\AUTO\RUNNER.PRG at boot
# (commands: build/src/runner.c). S: is the repository, D: the work copy, M: the RAM disk the makeprg rules
# use. makeprg rules one command at a time (Lattice make cannot run makeprg); the two aln lines of makeprg
# go to ALN as command files (gemsys/AB.LNK, GEM.LNK; the TOS command line is too short). Each language
# links its glue as _USARSC; after the link the symbol table is stripped (STRIP68.TOS; the release has
# none) and prgflags 7 7 is set as makeprg does. D:\MULTITOS\GEM_USA.SYS must be Atari's release
# (1993-02-04) byte for byte (EXPECT.LST); the other five have no Atari copy.

echo copy the sources to D:
rmtree D:\
rmtree M:\
cptree S:\MULTITOS D:\MULTITOS
copy C:\GEMSYS\AB.LNK D:\MULTITOS\AB.LNK
copy C:\GEMSYS\GEM.LNK D:\MULTITOS\GEM.LNK

echo AES binding library aesbin73: Alcyon C (cp68, c068 -f, c168) and MadMac 1.05 (mac -6) per member;
echo the lost assembler of the original members made addq/moveq of these add/move forms (subst)
cd D:\MULTITOS\AESBIND
x C:\BIN\CP68.TTP -I D:\MULTITOS\AESBIND\ header.c header.i
x C:\BIN\C068.TTP header.i header.1 header.2 header.3 -f
x C:\BIN\C168.TTP header.1 header.2 header.s
subst header.s add\s#1, addq\s#1,
subst header.s add.l\s#1, addq.l\s#1,
subst header.s move\s#1,R0 moveq\s#1,R0
x C:\SLAV\MAC.PRG -6 header.s
x C:\BIN\CP68.TTP -I D:\MULTITOS\AESBIND\ apexit.c apexit.i
