# link ........ bufdrv . buftyp . bufrec .... dirty . dmd ........ bufr ........
# The count argument is the number of bytes of each buffer to display.
# If zero or missing you get none, else you get that many.

procedure bcb a count
  print -n link -x lpeek(`a);(a += 4)
  print -n bufdrv -x wpeek(`a);(a += 2)
  print -n buftyp -x wpeek(`a);(a += 2)
  print -n bufrec -x wpeek(`a);(a += 2)
  print -n dirty -x wpeek(`a);(a += 2)
  print -n dmd -x lpeek(`a);(a += 4)
  print bufr -x lpeek(`a)
  if count 'd (lpeek(`a))[count] ; print'
.

# This global is used in fscl.c; if nonzero you see that many bytes of each
# buffer that's read or written.  It's initialized to zero, and we don't set
# it to zero here because re-loading this file shouldn't reset the value.

global bufdump

# the 'count' argument is how many buffers in each list to show; without it, 
# you get 10; with it, you get that many.  -1 is unreasonably large and will
# show all the buffers (unsigned compare).  The bytecount argument is how
# many bytes of each buffer to display; if zero or missing you get none, 
# else you get that many.  It's just passed to "bcb."

procedure allbcbs count bytecount
  local buf
  local lcount
  if (argc == 0) (count = 0a)
  (buf = lpeek(.bufl))
  print LIST 0: -x `buf
  (lcount = count)
#:loop0
    bcb `buf bytecount
    (buf = lpeek(`buf))
    (lcount -= 1)
  if (buf && lcount) goto loop0
  echo
  (buf = lpeek(.bufl + 4))
  print LIST 1: -x `buf
  (lcount = count)
#:loop1
    bcb `buf bytecount
    (buf = lpeek(`buf))
    (lcount -= 1)
  if (buf && lcount) goto loop1
.

alias _bcbs "if `t0 'bcb `t0;xt0 lpeek(`t0);_bcbs'"

# recsiz xxxx clsiz xxxx clsizb xxxx rdlen xxxx fsiz xxxx 
# fatrec xxxx datrec xxxx numcl xxxx b_flags xxxx

procedure bpb a
  print -n recsiz -x wpeek(`a);(a += 2)
  print -n clsiz -x wpeek(`a);(a += 2)
  print -n clsizb -x wpeek(`a);(a += 2)
  print -n rdlen -x wpeek(`a);(a += 2)
  print fsiz -x wpeek(`a);(a += 2)

  print -n fatrec -x wpeek(`a);(a += 2)
  print -n datrec -x wpeek(`a);(a += 2)
  print -n numcl -x wpeek(`a);(a += 2)
  print b_flags -x wpeek(`a);(a += 2)
.

# next xxxxxxxx use x time xxxx date xxxx strtcl xxxx fileln xxxxxx 
# attrib xx dirty x dev x dircl xxxx dirrec xxxx diroffs xxxx

procedure dfd a
  print -n next -x lpeek(`a);(a += 4)
  print -n prev -x lpeek(`a);(a += 4)
  print -n use -x wpeek(`a);(a += 2)
  print -n time -x wpeek(`a);(a += 2)
  print -n date -x wpeek(`a);(a += 2)
  print -n strtcl -x wpeek(`a);(a += 2)
  print fileln -x lpeek(`a);(a += 4)

  print -n attrib -x peek(`a);x a (`a+1)
  print -n dirty -x peek(`a);x a (`a+1)
  print -n dev -x wpeek(`a);(a += 2)
  print -n dircl -x wpeek(`a);(a += 2)
  print -n dirrec -x wpeek(`a);(a += 2)
  print diroffs -x wpeek(`a);(a += 2)
.

# dev x clust xxxx curcl xxxx recno xxxx recoffs xxxx bcb xxxxxxxx fcb xxxxxxxx

procedure dirx a
  print -n dev -x wpeek(`a);(a += 2)
  print -n clust -x wpeek(`a);(a += 2)
  print -n curcl -x wpeek(`a);(a += 2)
  print -n recno -x wpeek(`a);(a += 2)
  print -n recoffs -x wpeek(`a);(a += 2)
  print -n bcb -x lpeek(`a);(a += 4)
  print fcb -x lpeek(`a);(a += 4)
.

# dev x clust xxxx curcl xxxx recno xxxx recoffs xxxx bcb xxxxxxxx fcb xxxxxxxx

procedure dirf a
  print -n dev -x wpeek(`a);(a += 2)
  print -n clust -x wpeek(`a);(a += 2)
  print -n curcl -x wpeek(`a);(a += 2)
  print -n recno -x wpeek(`a);(a += 2)
  print -n recoffs -x wpeek(`a);(a += 2)
  print -n bcb -x lpeek(`a);(a += 4)
  print fcb -x lpeek(`a)
  fcb lpeek(`a);(a += 4)
.

# recfat xx  recrd xx recdata xx drvnum x fsiz xx clsiz x clsizb xxxx 
# recsiz xxxx numcl xxxx clrlog x clrm xxxx rblog x rbm xxxx clblog x 16 x

procedure dmd a
  print -n recfat -x wpeek(`a);(a += 2)
  print -n recrd -x wpeek(`a);(a += 2)
  print -n recdata -x wpeek(`a);(a += 2)
  print -n drvnum -x wpeek(`a);(a += 2)
  print -n fsiz -x wpeek(`a);(a += 2)
  print -n clsiz -x wpeek(`a);(a += 2)
  print clsizb -x wpeek(`a);(a += 2)

  print -n recsiz -x wpeek(`a);(a += 2)
  print -n numcl -x wpeek(`a);(a += 2)
  print -n clrlog -x wpeek(`a);(a += 2)
  print -n clrm -x wpeek(`a);(a += 2)
  print -n rblog -x wpeek(`a);(a += 2)
  print -n rbm -x wpeek(`a);(a += 2)
  print -n clblog -x wpeek(`a);(a += 2)
  print 16 -x wpeek(`a);(a += 2)
.

# dta_sname xxxxxxxxxxx dta_attr xx dta_clust xxxx dta_curcl xxxx 
# dta_recno xxxx dta_recoffs xxxx dta_dev x
# fattrib xx ftime xxxx fdate xxxx flength xxxxxxxx fname xxxxxxxx.xxx

procedure dta a
  print -n dta_sname -sb `a;x a (`a+b)
  print -n dta_attr -x peek(`a);x a (`a+1)
  print -n dta_clust -x wpeek(`a);(a += 2)
  print dta_curcl -x wpeek(`a);(a += 2)
  print -n dta_recno -x wpeek(`a);(a += 2)
  print -n dta_recoffs -x wpeek(`a);(a += 2)
  print dta_dev -x peek(`a);x a (`a+1)
  print -n fattrib -x peek(`a);x a (`a+1)
  print -n ftime -x wpeek(`a);(a += 2)
  print -n fdate -x wpeek(`a);(a += 2)
  print -n flength -x lpeek(`a);(a += 4)
  print fname -s `a;(a += 4)
.


# name xxxxxxxxxxx attrib xx time xxxx date xxxx clust xxxx filelen xxxxxxxx

procedure fcb a
  print -n name -sb `a;(a += b)
  print -n attrib -x peek(`a);(a += 1)
  (a += 0a)
  print -n time -x wpeek(`a);(a += 2)
  print -n date -x wpeek(`a);(a += 2)
  print -n clust -x wpeek(`a);(a += 2)
  print fileln -x lpeek(`a);(a += 4)
.


procedure md a
  print -n link -x lpeek(`a);(a += 4)
  print -n start -x lpeek(`a);(a += 4)
  print -n length -x lpeek(`a);(a += 4)
  print own -x lpeek(`a);(a += 4)
.

procedure mpb a
  print -n mp_mfl -x lpeek(`a);(a += 4)
  print -n mp_mal -x lpeek(`a);(a += 4)
  print mp_rover -x lpeek(`a);(a += 4)
.

procedure pmd
  local a
  echo ***** PMD
  mpb .pmd
  (a = lpeek(.pmd+4))
  echo ***** ALLOCATED LIST
#:loop
	if `a "md `a;(a = lpeek(`a));goto loop"

  (a = lpeek(.pmd))
  echo ***** FREE LIST
#:loop2
	if `a "md `a;(a = lpeek(`a));goto loop2"
.

alias allmds "pmd"

# next xxxxxxxx use x mode x o_dfd xxxxxxxx bytnum xxxxxx curcl xxxx currec xxxx

procedure ofd a
  print -n next -x lpeek(`a);(a += 4)
  print -n prev -x lpeek(`a);(a += 4)
  print -n dfd -x lpeek(`a);(a += 4)
  print -n use -x wpeek(`a);(a += 2)
  print -n mode -x wpeek(`a);(a += 2)
  print -n bytnum -x lpeek(`a);(a += 4)
  print -n curcl -x wpeek(`a);(a += 2)
  print currec -x wpeek(`a);(a += 2)
.

# p_lowtpa xxxxxxxx p_hitpa xxxxxxxx p_tbase xxxxxxxx p_tlen xxxxxxxx
# p_dbase xxxxxxxx p_dlen xxxxxxxx p_bbase xxxxxxxx p_blen xxxxxxxx
# p_xdta xxxxxxxx p_parent xxxxxxxx p_hflags xxxxxxxx p_env xxxxxxxx
# p_1fill {8} p_curdrv x p_uftsize xxxx p_uft xxxxxxxx
# p_curdir xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
# ======== xxxx xxxx xxxx xxxx xxxx xxxx xxxx xxxx
# p_3fill {8} p_dreg xxxxxxxx p_areg {5}
# p_cmdlin xx (string)

procedure pd a
  print -n p_lowtpa -x lpeek(`a);(a += 4)
  print -n p_hitpa -x lpeek(`a);(a += 4)
  print -n p_tbase -x lpeek(`a);(a += 4)
  print p_tlen -x lpeek(`a);(a += 4)
  print -n p_dbase -x lpeek(`a);(a += 4)
  print -n p_dlen -x lpeek(`a);(a += 4)
  print -n p_bbase -x lpeek(`a);(a += 4)
  print p_blen -x lpeek(`a);(a += 4)
  print -n p_xdta -x lpeek(`a);(a += 4)
  print -n p_parent -x lpeek(`a);(a += 4)
  print -n p_hflags -x lpeek(`a);(a += 4)
  print p_env -x lpeek(`a);(a += 4)
  print -n p_1fill {8};x a (`a+8)
  print -n p_curdrv -x wpeek(`a);(a += 2)
  print -n p_uftsize -x wpeek(`a);(a += 2)
  print p_uft -x lpeek(`a);(a += 4)

  print -n p_curdir -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -x04 wpeek(`a);(a += 2)

  print -n ======== -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -n -x04 wpeek(`a);(a += 2)
  print -x04 wpeek(`a);(a += 2)

  print -n p_3fill {8};(a += 8)
  print -n p_dreg -x lpeek(`a);(a += 4)
  print p_areg {5};(a += 14)
  print p_cmdlin -x peek(`a) -s (`a+1)
.

# g_magic xxxx g_tsize xxxxxxxx g_dsize xxxxxxxx g_bsize xxxxxxxx
# g_ssize xxxxxxxx g_junk1 xxxxxxxx g_hflags xxxxxxxx g_absflag xxxx

procedure prg a
  print -n g_magic -x wpeek(`a);(a += 2)
  print -n g_tsize -x lpeek(`a);(a += 4)
  print -n g_dsize -x lpeek(`a);(a += 4)
  print g_bsize -x lpeek(`a);(a += 4)

  print -n g_ssize -x lpeek(`a);(a += 4)
  print -n g_junk1 -x lpeek(`a);(a += 4)
  print -n g_hflags -x lpeek(`a);(a += 4)
  print g_absflg -x wpeek(`a);(a += 2)
.

# uft: given a pd (like lpeek(.run)) lists the uft.

procedure uft a
  local uft size count ofd
  set count 0
  set size wpeek(`a+3a)
  set uft lpeek(`a+3c)
#:loop
  set ofd lpeek(`uft)
  if `ofd print -n handle -d2 `count
  if (ofd && !(ofd & 1)) do_ofd `ofd
  if (ofd & 1) print tty -x (`ofd >> 1)
  (uft += 4)
  (count += 1)
  if (`count < `size) goto loop
.

procedure allofds
  local a
  a = lpeek(.ofd_head)
#:loop
  if (`a == 0) goto end
  do_ofd `a
  (a = lpeek(`a))
  goto loop
#:end
.

procedure do_ofd ofd
    print > OFD -x `ofd
    ofd `ofd
    print >> DFD -x lpeek(`ofd + 8)
    dfd lpeek(`ofd + 8)
.

# flag is "optional" -- if zero, show all blocks, but if 1, suppress free.
procedure block a flag
  local type
  if (!peek(`a+4)) goto end
  print -n b_next -x lpeek(`a);(a += 4)
  set type peek(`a)
  print -n b_type -x `type;(a += 1)
  print -n b_callno -x peek(`a);(a += 1)
  print -n b_data is -x `a
  if (`type == 0) print free
  if (`type == 1) "print cut: ; docut `a"
  if (`type == 0ff) print used
#:end
.

procedure docut a
  print -n slot 0: link: -x8 lpeek(`a) start: -x8 lpeek(`a + 4)
  print length: -x8 lpeek(`a + 8) own: -x8 lpeek(`a + c)
  (a += 10)
  print -n slot 1: link: -x8 lpeek(`a) start: -x8 lpeek(`a + 4)
  print length: -x8 lpeek(`a + 8) own: -x8 lpeek(`a + c)
  (a += 10)
  print -n slot 2: link: -x8 lpeek(`a) start: -x8 lpeek(`a + 4)
  print length: -x8 lpeek(`a + 8) own: -x8 lpeek(`a + c)
  (a += 10)
  print -n slot 3: link: -x8 lpeek(`a) start: -x8 lpeek(`a + 4)
  print length: -x8 lpeek(`a + 8) own: -x8 lpeek(`a + c)
.

# db complained about recusion in the following, so I made it a proc
#alias allblocks "(t0 = lpeek(.blockhead));_blocks"
#alias _blocks "if `t0 'block `t0 1;(t0 = lpeek(`t0));_blocks'"
procedure allblocks
    local bl
    `bl = lpeek(.blockhead)
    print all blocks:
#:doblock
    if !`bl goto end
    print -n -x07 `bl
    block `bl 1
    `bl = lpeek(`bl)
    goto doblock
#:end
    print done.
.


procedure pdtab
  local pd ppd ppdend
  (ppd = .pdtab)
  (ppdend = .pdtab + 20 * 4)		; # this assumes NUMPDS is 0x20

#:loop
    (pd = lpeek(`ppd))
    if `pd "print PROCESS -x `pd;pd `pd;print UFT FOR -x `pd;uft `pd"
    (ppd += 4)
    if (`ppd < `ppdend) goto loop
.

procedure alldmds
    local dmd dmdend mask
    (mask = 1)
    (dmd = .drvtbl)
    (dmdend = .drvtbl + @30*@16)
#:loop
      if (wpeek(.drvsel) & `mask) "dmd `dmd;print"
      (dmd += @30)
      (mask <<= 1)
      if (`dmd < `dmdend) goto loop
.

procedure everything
    print MEMORY

    allmds

    print DMDs
    alldmds

    print DISK BUFFERS

    allbcbs -1 `bufdump

    print POOL

    allblocks

    print PROCESSES, OFDs, DFDs

    pdtab
.

# showtail and _dopexec lifted from db.rc; xexec calls _dopexec.

procedure showtail tail
  gag push ; f`tail[7f] 0d ; gag pop
  if $ print -n -s($-(`tail-1)) `tail
  if !$ print -n -s `tail
.

procedure _dopexec mode arg1 arg2 arg3
  print -n Pexec -x `mode
  if (mode == 0 || mode == 3) "print -n name= -x `arg1 -s `arg1 tail=;showtail arg2+1;print env= -x `arg3"
  if (mode == 4 || mode == 6) print arg1= -x `arg1 basepage= -x `arg2 arg3 = -x `arg3
  if (mode == 5 || mode == 7) "print -n arg1= -x `arg1 tail=;showtail arg2+1;print env= -x `arg3"
.

# this alias is used by DBCMDs in the source

alias _c defer g
