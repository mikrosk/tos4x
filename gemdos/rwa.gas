| This rev isn't up to spec w.r.t. rwa.mac of this date.
|

| this include file defines JUST_LONG, which controls whether to test
| _longframe or just assume you're on a long-frame machine.

|.include "switches.s"

    .text
	.globl	_uc		| placed here for space savings
	.globl	_s68		| swap bytes in word
	.globl	_s68l		| swap bytes in longword
	.globl	_setjmp		| setjmp(...)
	.globl	_longjmp	| longjmp(...)
	.globl	_dojmp		| "jump" / "goto"
	.globl	_gouser		| resume process
	.globl	_oscall		| trap GEMDOS from within GEMDOS
	.globl	_trap13		| BIOS trap binding
	.globl	_trap14		| XBIOS trap handling (AKP)
	.globl	_osinit		| GEMDOS initialization

| imports:
	.globl	_xterm		| terminate process (with return code)
	.globl	_cinit		| GEMDOS initialization (C part)
	.globl	_run		| -> current process's basepage
	.globl	_tikfrk		| timer tick handler
	.globl	_osif		| GEMDOS trap switch
	.globl	_GSX_ENTRY	| VDI handler
	.globl	_longframe	| 68010-style stack frame flag (in startup.s)

|+
|  Initialization;
|  called by osi() which is called by BIOS early in system initialization.
|
|-
_osinit:
	movel	#_enter,0x84		| install trap #1 vector
	movel	0x88,obdos		| install trap #2 vector
	movel	#exit,0x88

	movew	sr,savesr		| install system timer vector
	oriw	#0x700,sr		| disable interrupts
	movel	#tikhnd,sp@-		| otime = Setexc(0x100, &tikhnd);
	movew	#0x100,sp@-
	movew	#5,sp@-
	trap	#13
	addql	#8,sp
	movel	d0,otime		| (save old timer vector)
	movew	savesr,sr		| restore IPL
	jsr	_cinit			| initialize GEMDOS
	rts


|+
|  Trap 13 Handler
|
|-
_trap13:
	movel	sp@+,biosav		| save return address
	trap	#13			| do the trap
	movel	biosav,sp@-		| restore return address, return
	rts

_trap14:
	movel	sp@+,biosav
	trap	#14
	movel	biosav,sp@-
	rts

|+
|  Trap 2 handler
|
|  This is a kind of mish-mash:
|    If D0 == 0x0000, terminate the current process (old CP/M terminate).
|    If D0 == 115, call VDI, `_GSX_ENTRY', and return via RTE;
|    If D0 == 0xffff, return address of _GSX_ENTRY in D0.L;
|    Otherwise, follow old Trap 2 vector (which should just RTE).
|
|-
exit:	tstw	d0			| if D0 == 0x0000, Pterm0().
	beq	exit_x			| (bye bye)
	cmpw	#115,d0			| if D0 == 115, call VDI
	bne	exit_1			| (don't call)
	jsr	_GSX_ENTRY		| call VDI
	rte				| and return

exit_1:	cmpw	#-1,d0			| if D0 == 0xffff, return address
	bne	exit_2			|	of VDI's entry point.
	movel	#_GSX_ENTRY,d0		| return it
	rte

exit_2:	movel	obdos,sp@-		| follow old Trap 2 vector
	rts

exit_x:	movel	fsstak,sp		| get file system's stack
	clrw	sp@-			| return code = 0x0000
	bsr	_xterm			| terminate (never returns)

|+
|  uc(c): returns (islower(c) ? toupper(c) : c)
|
|-
 
_uc:	movew	sp@(4),d0
	cmpb	#96,d0
 	blt	ucdone
 	cmpb	#122,d0
 	bgt	ucdone
 	bclr	#5,d0			| clear 0x20 bit to downcase
ucdone:	rts
 
|+
|  Timer Tick Handler;
|  call C code, then follow the chain.
|
|-
tikhnd:
	movew	sp@(4),sp@-		| push #ms
	jsr	_tikfrk			| call GEMDOS handler
	addql	#2,sp			| cleanup stack
	movel	otime,sp@-		| follow old vector
	rts


|+
|  void dojmp(addr);
|  long addr;
|
|  Jump to `addr'.
|
|-
_dojmp:
	movel	sp@(4),sp@-		| get addr
	rts				| "return" to it


|+
|  WORD s68(waddr)
|  WORD *waddr;
|
|  Swap bytes in word at `waddr'.
|
|-
_s68:
	movel	sp@(4),a0		 | a0 -> word
	movew	a0@,d0			| get word
	rorw	#8,d0			| swap bytes
	movew	d0,a0@			| stuff word back
	rts				| return word in D0



|+
|  LONG s68(laddr)
|  LONG *laddr;
|
|  Swap bytes in longword at `laddr'.
|	3210 --> 0123
|
|-
_s68l:
	movel	sp@(4),a0		| a0 -> longword
	movel	a0@,d0			| get longword
	rorw	#8,d0			| swap low word
	swap	d0			| switch high and low words
	rorw	#8,d0			| swap high word
	movel	d0,a0@			| stuff back into memory
	rts				| return in D0


|+
|  long setjmp(context)
|  long *context;
|
|  Save PC/stack context for `longjmp()'.
|
|  struct context {
|	long stk;
|	...?
|	long retaddr;
|  }
|
|-
_setjmp:
	link	a6,#0			| make stack look pretty
	movel	a6@(8),a0		| a0 -> context block
	movel	a6@,a0@+		| save stack ptr
	lea	a6@(8),a1		| a1 -> 
	movel	a1,a0@+
	movel	a6@(4),a0@
	clrl	d0
	unlk	a6
	rts


|+
|  void longjmp(context, retcode)
|  long *context;
|  long retcode;
|
|  "Return" to context saved by `setjmp()'.
|
|-
_longjmp:
	link	a6,#0			| DRI likes this
	movel	a6@(0xc),d0
	tstl	d0
	bne	okrc

	movew	#1,d0
okrc:
	movel	a6@(8),a0
	movel	a0@+,a6
	movel	a0@+,sp
	movel	a0@,sp@-
	rts


|+
|  Trap 1 handler
|
|    Short-circuit Super();
|
|-
_enter:
	btst	#5,sp@	 		| in supervisor mode?
	bne	ent_1			| (yes, check super stack)

	movel	usp,a0			| function == Super() on user stack?
	cmpw	#0x20,a0@	
	beq	x20_usr			| (yes -- do it)
	bra	ent_2

ent_1:
|.ifeq JUST_LONG
	tstw	_longframe		| using long frames?
	bne	long3			| yes
	cmpw	#0x20,sp@(6)		| no - test shoft frame
	beq	x20_sup
	bra	ent_2
long3:
|.endc
	cmpw	#0x20,sp@(8)		| use offset 8 for long frames
	beq	x20_sup			| (yes -- do it)

ent_2:	movel	a6,sp@- 		| save A6
	movel	_run,a6			| A6 -> process's baspage
	moveml	d0/a3-a5,a6@(0x68)	| save registers in basepage
	movel	sp@+,a6@(0x78)		| (save A6, too)
	movew	sp@+,d0			| D0 = caller's SR
	movel	sp@+,a4			| A4 = caller's return address
|.ifeq JUST_LONG
	tstw	_longframe		  | using long frames?
	beq	notlong1		| nope
|.endc
	addql	#2,sp			| drop the frame word now
notlong1:
	btst   #13,d0			| use caller's stack if he's supervisor
	bne	systk			| (use his)

	movel	usp,a5			| a5 = user's stack
	moveml	d1-d7/a0-a2,a5@-	| save registers
	movel	a4,a5@-			| save return address
	movew	d0,a5@-			| save SR
	movel	sp,a0			|???
	movel	a0,a5@-			|???
	movel	a5,a6@(0x7c)		|???
| now switch to fs stack
	movel	#fstrt,sp		| SSP -> top of our stack
	lea	a5@(50),a0		| a0 -> user's parameters
	bra	callos			| call osif()

| he was using his own ssp
systk:	moveml	d1-d7/a0-a2,sp@-
	movel	a4,sp@-
	movew	d0,sp@-
	movel	usp,a0
	movel	a0,sp@-
	movel	sp,a6@(0x7c)
	lea	sp@(50),a0
	movel	#fstrt,sp

callos: movel	a0,sp@- 	| push parameter ptr
	jsr	_osif			| call GEMDOS trap handler
	addql	#4,sp			| cleanup stack, fall into gouser;

|+
| This version of gouser finally fixes a bug: the return value from
| GEMDOS can come from either of two places: it can be in d0 (return
| value from osif()), or in the d0 save location in the basepage
| (from Pexec).  The difference is that osif returns to here,
| and Pexec calls _gouser directly.  Therefore, the entry _gouser
| moves the d0 save location in the basepage into d0, then jumps
| to __gouser to continue the return process.
|-

__gouser:
	movel  _run,a5		       | a5 -> current process's basepage
	movel	d0,a5@(0x68)		| install return value
	movel	a5@(0x7c),a6		| stack pointer (maybe usp, maybe ssp)
	movel	a6@+,a4		| other stack pointer
	movew	a6@+,d0		| D0 = user's SR
	movel	a6@+,a3		| A3 = user's return address
	moveml	a6@+,d1-d7/a0-a2
	btst	#13,d0		  | in supervisor mode?
	bne	retsys			| (yes, a6 is system stack)
	movel	a4,sp			| A4 is SSP
	movel	a6,usp			| A6 is USP

gousr:

|.ifeq JUST_LONG
	tstw	_longframe		  | using long frames?
	beq	notlong2		| nope
|.endc
	clrw	sp@-			| yes - move zero frame word
notlong2:
	movel  a3,sp@-	       | push return address
	movew	d0,sp@-		| push user's SR
	moveml	a5@(0x68),d0/a3-a6	| restore registers
	rte				| return from GEMDOS trap

retsys: movel	a6,sp			| A6 is SSP
	movel	a4,usp			| A4 was USP
	bra	gousr			| return anyway

| bug fix - see above comments

_gouser:
	movel	_run,a5
	movel	a5@(0x68),d0
	bra	__gouser

|+
|  GEMDOS Super(), function 0x20, handler
|  Get/Set/Inquire supervisor mode
|
|  On entry to this point, a0 contains usp.
|
|  Just to show how much we bend over backwards to support backward
|  compatiblity, the code for Super(0L) from user mode should not 
|  use A1: Arctic Fox expects it to be preserved across this call.
|-

| Super call from user mode
x20_usr:
	movel	a0@(2),d1	| get parameter
	beq	xu_0		| already have new SSP from
|				| old USP, go handle 0L entry

	subql	#1,d1		| check for -1L entry
	beq	x20_inq		| go handle inquiry

	movel	a0@(2),a0	| get new SSP from parameter
xu_0:
|.ifne JUST_LONG
|	lea	a0@(-6),a0 | bump a0 down by 6: PC and frame word
|	movew	sp@+,d0	| put SR in d0 (munged and pushed later)
|	movel	sp@+,a0@	| put PC on this new stack
|	movew	sp@+,a0@(4)	| put frame word on this stack
|.else
	movew	sp@+,d0 | pop SR
	movel	sp@+,d1	| pop return PC

	tstw	_longframe	| long frames?
	beq	notlong4
	movew	sp@+,a0@-	 | transport the (zero) frame word

notlong4:
	movel  d1,a0@-	       | transport the return address
|.endc
	oriw	#0x2000,d0	| set supervisor mode
	movew	d0,a0@-		| push SR
	movel	sp,d0		| set return value (old SSP)
	movel	a0,sp		| set new SSP
	rte			| and everything is cool

| Super call from supervisor mode

x20_sup:
|.ifeq JUST_LONG
	tstw	_longframe	  | long frames?
	beq	notlong5	| no...
|.endc
	movel	sp@(0xa),d1	| get parameter (long form)
	beq	xs_0		| handle Super(0L) from super mode
	subql	#1,d1
	beq	x20_inq 	   | handle Super(1L); (inquiry)
	movel	sp@(0xa),a1	| get parm
	movew	sp@+,d0	| get SR
	movel	sp@+,d1	| get PC
	movew	sp@+,a1@-	| transport (zero) frame word
	movel	d1,a1@-		| push PC

|.ifeq JUST_LONG
	bra	temp2		| finish up here

notlong5:
	movel	sp@(8),d1	| get parameter
	beq	xs_0		| go handle Super(0L) from super mode
	subql	#1,d1		| check for Super(1L)
	beq	x20_inq		| go handle Super(1L) (inquiry)

	movel	sp@(8),a1	| point to new SSP
	movew	sp@+,d0	| pop SR
	movel	sp@+,a1@-	| transport the return address
temp2:
|.endc
	movew	d0,a1@-		| finish up here: push SR
	movel	usp,a0		| get USP
	cmpal	a0,sp		| already at old USP?
	beq	xs_usp		| don't play with stack

	movel	sp@+,a0@-	| transport func # and parm
	movel	a1,sp		| update SSP
	bra	xs_exit

xs_usp:
	movel	a1,sp		| update SSP
	bra	xs_scram

| xs_0: handle Super(0L) from Super mode: go to USER mode with USP = SSP
xs_0:
|.ifeq JUST_LONG
	lea	sp@(6),a0	| create USP (preload for short frames)
	tstw	_longframe
	beq	xs_1
|.endc
	lea	sp@(8),a0	| create USP for long frames
xs_1:

xs_exit:
	movel	a0,usp		| update USP
xs_scram:
	andiw	#0xDFFF,sp@	| set user mode
	rte			| and clear out

| inquiry mode entry point

x20_inq:
	movel	#0x2000,d0	| set up test mask
	andw	sp@,d0		| check the supervisor state
	beq	xi_exit		| return 0L for user mode

	moveql	#-1,d0		| return -1L for sup mode
xi_exit:
	rte


|
| call dosjr from within itself (or from linked-in shell)
|
_oscall:
	link	a6,#0
	movel	a0,sp@-
	lea	a6@(8),a0
	movel	a0,sp@-
	jsr	_osif
	addql	#4,sp
	movel	sp@+,a0
	unlk	a6
	rts

|----------------
|
|  Bring GEMDOS up to date with the BIOS's idea
|  (which is a real-time clock chip if there's one installed in the system)
|  (Note: before 7/89, this jsr'ed directly into BIOS; now it traps.)
|
	.globl	_clksync			| (export)
	.globl	_date,_time			| (import)

_clksync:
	movew	#0x17,sp@-			| Gettime XBIOS call
	trap	#0xe
	addql	#2,sp
	movew	sr,d1			| save IPL
	orw	#0x0700,sr		| disable interrupts
	movew	d0,_time		|;<7> set time
	swap	d0			|;<7>
	movew	d0,_date		|;<7> set date
	movew	d1,sr			|;<7> re-enable interrupts
	rts


|----------------
|
|  Update BIOS clock from GEMDOS's idea of the time
|  (called by the settime/setdate functions)
|
	.globl	_upd_tod
_upd_tod:
	movew	_time,sp@-		| time in low word
	movew	_date,sp@-		| date in high word
	movew	#0x16,sp@-		| Settime(date << 16 | time)
	trap	#14
	addql	#6,sp			| cleanup and return
	rts


| lmul.s

|------------------------------------------------------------------------
|									:
|	Long Multiply							:
|	(C)1986 Atari Corp.						:
|									:
|---- edit history (reverse order, please)				:
|									:
| 17-Jan-1986 lmd	Cleaned-up DRI source code.  It could use one	:
|			more sweep to clean up stupid compiled code.	:
|									:
|------------------------------------------------------------------------


|
|  SYNOPSIS
|    LONG lmul(long1, long2)
|    long long1, long2;
|
|    Returns long value in D0.  No overflow checking.
|
|  ---- editorial ----
|  The actual origin of this code may be forever lost in the mists
|  of history.  It /appears/ to be hacked-up assembly output from
|  the Alcyon `C' compiler.  Surely no human would write something
|  like this.  It /had/ to be someone from DRI ....
|  -------------------
|

	.text
	.globl	lmul
|
lmul:
	link	a6,#-4		| git us some stack space, bartender
	clrw	d2		| zap sign flag
	tstl	a6@(8)		| is first argument negative?
	bge	L2		| (nope)
	negl	a6@(8)		| yes, negate it
	addqw	#1,d2		| increment sign flag
L2:	tstl	a6@(12)		| is second argument negative?
	bge	L3		| (nope)
	negl	a6@(12)		| yes, make it positive
	addqw	#1,d2		| increment sign flag
L3:	movew	a6@(10),d0	| D0 = arg1.low * arg2.low
	mulu	a6@(14),d0
	movel	d0,a6@(-4)
	movew	a6@(8),d0	| D0 = arg1.hi * arg2.low
	mulu	a6@(14),d0
	movew	a6@(12),d1	| D1 = arg2.hi * arg1.low
	mulu	a6@(10),d1
	addw	d1,d0		| D0 = arg1.hi*arg2.low + arg2.hi*arg1.low
	addw	a6@(-4),d0	| D0 += arg1.low * arg2.low (from temp)
	movew	d0,a6@(-4)	| store back in temp hiword
	movel	a6@(-4),d0	| long results [what a stupid compiler]
	btst	#0,d2		| test sign flag
	beq	L4		| (even -- signs evened out)
	negl	d0		| odd - negate result
L4:	unlk	a6		| cleanup stack and return
	rts


|
| DRI ldiv code -- could be cleaned up (a lot) or rewritten
|
| mac-incompatible lines removed/edited 3/88 AKP
|

	.comm	_ldivr,4
	.globl	_ldiv
	.globl	ldiv
	.text
_ldiv:
ldiv:
	link	a6,#-2
	moveml	d2-d7,sp@-
	clrw	d3
	clrl	d5
	movel	a6@(8),d7
	movel	a6@(12),d6
	bne	xL2
	movel	#0x80000000,_ldivr
	movel	#0x80000000,d0
	divs	#0,d0		| *<<<<< div by zero trap   whf 3/7/84
	bra	xL1
xL2:
	bge	xL3
	negl	d6
	addqw	#1,d3
xL3:
	tstl	d7
	bge	xL4
	negl	d7
	addqw	#1,d3
xL4:
	cmpl	d7,d6
	bgt	xL6
	bne	xL7
	movel	#1,d5
	clrl	d7
	bra	xL6
xL7:
	cmpl	#0x10000,d7
	bge	xL9
	divu	d6,d7
	movew	d7,d5
	swap	d7
	extl	d7
	bra	xL6
xL9:
	movel	#1,d4
xL12:
	cmpl	d6,d7
	bcs	xL11
	asll	#1,d6
	asll	#1,d4
	bra	xL12
xL11:
	tstl	d4
	beq	xL6
	cmpl	d6,d7
	bcs	xL15
	orl	d4,d5
	subl	d6,d7
xL15:
	lsrl	#1,d4
	lsrl	#1,d6
	bra	xL11
xL6:
	cmpw	#1,d3
	bne	xL16
	negl	d7
	movel	d7,_ldivr
	movel	d5,d0
	negl	d0
	bra	xL1
xL16:
	movel	d7,_ldivr
	movel	d5,d0
xL1:
	addql	#4,sp
	moveml	sp@+,d3-d7
	unlk	a6
	rts

|
| usr2xfr(n,d,s)
| xfr2usr(n,s,d) (note argument ordering)
|
| Copy n bytes from s to d.  N can be odd, and s or d can be odd, but 
| not usually.
|

.globl _usr2xfr
.globl _xfr2usr

_usr2xfr:
	movel	sp@(0x6),a1
	movel	sp@(0xa),a0	| a0 is source
	bra	doxfr

_xfr2usr:
	movel	sp@(0x6),a0
	movel	sp@(0xa),a1

doxfr:	movew	sp@(4),d0	| d0 is count

	btst	#0,d0		| if count is odd or either addr is odd,
	bne	odd		| then use a byte move.
	movew	a0,d1
	movew	a1,d2		| (This would be "orw a1,d1" but the
	orw	d2,d1		| 68000 doesn't allow that.)
	btst	#0,d1
	bne	odd

| use a word or long move.
| We branch to end of dbra loop in case count is zero.

	movew	d0,d1
	asrw	#2,d1
	bra	ewloop
wloop:	movel	a0@+,a1@+
ewloop:	dbra	d1,wloop
	andw	#3,d0		| do the trailing word if any
	beq	done
	movew	a0@+,a1@+
done:	rts

bloop:	moveb	a0@+,a1@+
odd:	dbra	d0,bloop
	rts

	.data

	.even
fsstak:	.long	fstrt

.lcomm	bssstrt,2
.lcomm	biosav,4
.lcomm	saveret,4
.lcomm	savesr,2
.lcomm	retshell,4
.lcomm	regsav,16*4

.lcomm  gemdosstack,2000
.set fstrt,gemdosstack+2000
.lcomm	otime,4
.lcomm	obdos,4
