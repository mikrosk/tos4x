echo resource glue: glue.usa from gemusa.rsc, deskusa.rsc, deskusa.inf (2.06 USA)
cd D:\ROM
copy D:\AES\RSC\206\GEMUS.RSC D:\ROM\GEMUSA.RSC
copy D:\DESK\RSC\206\DESKUS.RSC D:\ROM\DESKUSA.RSC
copy D:\DESK\RSC\206\DESKUS.INF D:\ROM\DESKUSA.INF
type usa\rexit\r
x C:\GLUE\NEWGLUE.PRG
# NEWGLUE never writes these padding bytes; tos207.rom has these values there
poke D:\ROM\GLUE.USA 5036 0e60
poke D:\ROM\GLUE.USA 29159 1b
poke D:\ROM\GLUE.USA 29161 40
poke D:\ROM\GLUE.USA 29835 01
poke D:\ROM\GLUE.USA 29837 09ffffffff

echo ROM from the sources
setenv PATH=C:\LC\BIN;C:\SLAV;C:\BIN;C:\UTIL
cd D:\ROM
x make
echo two ROM chips (even and odd bytes), one CRC-16 each, as startup.s checks them
romimg tos.abs tos.img 262144 2

echo compare with the expected checksums
check C:\EXPECT.LST
