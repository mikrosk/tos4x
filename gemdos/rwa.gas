* this include file defines JUST_LONG, which controls whether to test
* _longframe or just assume you're on a long-frame machine.

.include "switches.s"

    .text
	.globl	_uc		; placed here for space savings
	.globl	_s68		; swap bytes in word
	.globl	_s68l		; swap bytes in longword
	.globl	_setjmp		; setjmp(...)
	.globl	_longjmp	; longjmp(...)
	.globl	_dojmp		; "jump" / "goto"
	.globl	_gouser		; resume process
	.globl	_oscall		; trap GEMDOS from within GEMDOS
	.globl	_trap13		; BIOS trap binding
	.globl	_trap14		; XBIOS trap handling (AKP)
	.globl	_osinit		; GEMDOS initialization

* imports:
	.globl	_xterm		; terminate process (with return code)
	.globl	_cinit		; GEMDOS initialization (C part)
	.globl	_run		; -> current process's basepage
	.globl	_tikfrk		; timer tick handler
	.globl	_osif		; GEMDOS trap switch
	.globl	_GSX_ENTRY	; VDI handler
	.globl	_longframe	; 68010-style stack frame flag (in startup.s)

*+
*  Initialization;
*  called by osi() which is called by BIOS early in system initialization.
*
*-
_osinit:
	move.l	#_enter,$84		; install trap #1 vector
	move.l	$88,obdos		; install trap #2 vector
	move.l	#exit,$88

	move.w	sr,savesr		; install system timer vector
	ori.w	#$700,sr		; disable interrupts
	move.l	#tikhnd,-(sp)		; otime = Setexc(0x100, &tikhnd);
	move	#$100,-(sp)
	move	#5,-(sp)
	trap	#13
	addq.l	#8,sp
	move.l	d0,otime		; (save old timer vector)
	move.w	savesr,sr		; restore IPL
	jsr	_cinit			; initialize GEMDOS
	rts


*+
*  Trap 13 Handler
*
*-
_trap13:
	move.l	(sp)+,biosav		; save return address
	trap	#13			; do the trap
	move.l	biosav,-(sp)		; restore return address, return
	rts

_trap14:
	move.l	(sp)+,biosav
	trap	#14
	move.l	biosav,-(sp)
	rts

*+
*  Trap 2 handler
*
*  This is a kind of mish-mash:
*    If D0 == 0x0000, terminate the current process (old CP/M terminate).
*    If D0 == 115, call VDI, `_GSX_ENTRY', and return via RTE;
*    If D0 == 0xffff, return address of _GSX_ENTRY in D0.L;
*    Otherwise, follow old Trap 2 vector (which should just RTE).
*
*-
exit:	tst.w	d0			; if D0 == 0x0000, Pterm0().
	beq.b	exit_x			; (bye bye)
	cmp.w	#115,d0			; if D0 == 115, call VDI
	bne.b	exit_1			; (don't call)
	jsr	_GSX_ENTRY		; call VDI
	rte				; and return

exit_1:	cmp.w	#-1,d0			; if D0 == 0xffff, return address
	bne.b	exit_2			;	of VDI's entry point.
	move.l	#_GSX_ENTRY,d0		; return it
	rte

exit_2:	move.l	obdos,-(sp)		; follow old Trap 2 vector
	rts

exit_x:	move.l	fsstak,sp		; get file system's stack
	clr.w	-(sp)			; return code = 0x0000
	bsr	_xterm			; terminate (never returns)

_brkp:	illegal				; "cannot happen"
	rte				; "cannot happen"


*+
*  uc(c): returns (islower(c) ? toupper(c) : c)
*
*-
 
_uc:	move.w	4(sp),d0
	cmp.b	#'a',d0
 	blt.b	ucdone
 	cmp.b	#'z',d0
 	bgt.b	ucdone
 	bclr.l	#5,d0			; clear 0x20 bit to downcase
ucdone:	rts
 
*+
*  Timer Tick Handler;
*  call C code, then follow the chain.
*
*-
tikhnd:
	move.w	4(sp),-(sp)		; push #ms
	jsr	_tikfrk			; call GEMDOS handler
	addq.l	#2,sp			; cleanup stack
	move.l	otime,-(sp)		; follow old vector
	rts


*+
*  void dojmp(addr);
*  long addr;
*
*  Jump to `addr'.
*
*-
_dojmp:
	move.l	4(sp),-(sp)		; get addr
	rts				; "return" to it


*+
*  WORD s68(waddr)
*  WORD *waddr;
*
*  Swap bytes in word at `waddr'.
*
*-
_s68:
	move.l	4(a7),a0		; a0 -> word
	move	(a0),d0			; get word
	ror	#8,d0			; swap bytes
	move	d0,(a0)			; stuff word back
	rts				; return word in D0



*+
*  LONG s68(laddr)
*  LONG *laddr;
*
*  Swap bytes in longword at `laddr'.
*	3210 --> 0123
*
*-
_s68l:
	move.l	4(a7),a0		; a0 -> longword
	move.l	(a0),d0			; get longword
	ror	#8,d0			; swap low word
	swap	d0			; switch high and low words
	ror	#8,d0			; swap high word
	move.l	d0,(a0)			; stuff back into memory
	rts				; return in D0


*+
*  long setjmp(context)
*  long *context;
*
*  Save PC/stack context for `longjmp()'.
*
*  struct context {
*	long stk;
*	...?
*	long retaddr;
*  }
*
*-
_setjmp:
	link	a6,#0			; make stack look pretty
	move.l	8(a6),a0		; a0 -> context block
	move.l	0(a6),(a0)+		; save stack ptr
	lea	8(a6),a1		; a1 -> 
	move.l	a1,(a0)+		; 
	move.l	4(a6),(a0)
	clr.l	d0
	unlk	a6
	rts


*+
*  void longjmp(context, retcode)
*  long *context;
*  long retcode;
*
*  "Return" to context saved by `setjmp()'.
*
*-
_longjmp:
	link	a6,#0			; DRI likes this
	move.l	12(a6),d0
	tst.l	d0
	bne.b	okrc

	move	#1,d0
okrc:
	move.l	8(a6),a0
	move.l	(a0)+,a6
	move.l	(a0)+,a7
	move.l	(a0),-(sp)
	rts


*+
*  Trap 1 handler
*
*    Short-circuit Super();
*
*-
_enter:
	btst.b	#5,(sp)			; in supervisor mode?
	bne.b	ent_1			; (yes, check super stack)

	move.l	usp,a0			; function == Super() on user stack?
	cmp.w	#$20,(a0)	
	beq	x20_usr			; (yes -- do it)
	bra.b	ent_2

ent_1:
.ifeq JUST_LONG
	tst.w	_longframe		; using long frames?
	bne.b	long3			; yes
	cmp.w	#$20,6(sp)		; no - test shoft frame
	beq	x20_sup
	bra	ent_2
long3:
.endc
	cmp.w	#$20,8(sp)		; use offset 8 for long frames
	beq	x20_sup			; (yes -- do it)

ent_2:	move.l	a6,-(sp)		; save A6
	move.l	_run,a6			; A6 -> process's baspage
	movem.l	d0/a3-a5,$68(a6)	; save registers in basepage
	move.l	(sp)+,$78(a6)		; (save A6, too)
	move	(sp)+,d0		; D0 = caller's SR
	move.l	(sp)+,a4		; A4 = caller's return address
.ifeq JUST_LONG
	tst.w	_longframe		; using long frames?
	beq.b	notlong1		; nope
.endc
	addq.l	#2,sp			; drop the frame word now
notlong1:
	btst	#13,d0			; use caller's stack if he's supervisor
	bne.b	systk			; (use his)

	move.l	usp,a5			; a5 = user's stack
	movem.l	d1-d7/a0-a2,-(a5)	; save registers
	move.l	a4,-(a5)		; save return address
	move.w	d0,-(a5)		; save SR
	move.l	sp,a0			;???
	move.l	a0,-(a5)		;???
	move.l	a5,$7c(a6)		;???
* now switch to fs stack
	move.l	#fstrt,sp		; SSP -> top of our stack
	lea	50(a5),a0		; a0 -> user's parameters
	bra.b	callos			; call osif()

* he was using his own ssp
systk:	movem.l	d1-d7/a0-a2,-(sp)
	move.l	a4,-(sp)
	move	d0,-(sp)
	move.l	usp,a0
	move.l	a0,-(sp)
	move.l	sp,$7c(a6)
	lea	50(sp),a0
	move.l	#fstrt,sp

callos:	move.l	a0,-(sp)		; push parameter ptr
	jsr	_osif			; call GEMDOS trap handler
	addq.l	#4,sp			; cleanup stack, fall into gouser;

*+
* This version of gouser finally fixes a bug: the return value from
* GEMDOS can come from either of two places: it can be in d0 (return
* value from osif()), or in the d0 save location in the basepage
* (from Pexec).  The difference is that osif returns to here,
* and Pexec calls _gouser directly.  Therefore, the entry _gouser
* moves the d0 save location in the basepage into d0, then jumps
* to __gouser to continue the return process.
*-

__gouser:
	move.l	_run,a5			; a5 -> current process's basepage
	move.l	d0,$68(a5)		; install return value
	move.l	$7c(a5),a6		; stack pointer (maybe usp, maybe ssp)
	move.l	(a6)+,a4		; other stack pointer
	move.w	(a6)+,d0		; D0 = user's SR
	move.l	(a6)+,a3		; A3 = user's return address
	movem.l	(a6)+,d1-d7/a0-a2
	btst	#13,d0			; in supervisor mode?
	bne.b	retsys			; (yes, a6 is system stack)
	move.l	a4,sp			; A4 is SSP
	move.l	a6,usp			; A6 is USP

gousr:

.ifeq JUST_LONG
	tst.w	_longframe		; using long frames?
	beq.b	notlong2		; nope
.endc
	clr.w	-(sp)			; yes - move zero frame word
notlong2:
	move.l	a3,-(sp)		; push return address
	move.w	d0,-(sp)		; push user's SR
	movem.l	$68(a5),d0/a3-a6	; restore registers
	rte				; return from GEMDOS trap

retsys:	move.l	a6,sp			; A6 is SSP
	move.l	a4,usp			; A4 was USP
	bra.b	gousr			; return anyway

* bug fix - see above comments

_gouser:
	move.l	_run,a5
	move.l	$68(a5),d0
	bra	__gouser

*+
*  GEMDOS Super(), function 0x20, handler
*  Get/Set/Inquire supervisor mode
*
*  On entry to this point, a0 contains usp.
*
*  Just to show how much we bend over backwards to support backward
*  compatiblity, the code for Super(0L) from user mode should not 
*  use A1: Arctic Fox expects it to be preserved across this call.
*-

* Super call from user mode
x20_usr:
	move.l	2(a0),d1	; get parameter
	beq.b	xu_0		; already have new SSP from
*				; old USP, go handle 0L entry

	subq.l	#1,d1		; check for -1L entry
	beq.b	x20_inq		; go handle inquiry

	move.l	2(a0),a0	; get new SSP from parameter
xu_0:
.ifne JUST_LONG
	lea.l	-6(a0),a0	; bump a0 down by 6: PC and frame word
	move.w	(sp)+,d0	; put SR in d0 (munged and pushed later)
	move.l	(sp)+,(a0)	; put PC on this new stack
	move.w	(sp)+,4(a0)	; put frame word on this stack
.else
	move.w	(sp)+,d0	; pop SR
	move.l	(sp)+,d1	; pop return PC

	tst.w	_longframe	; long frames?
	beq.b	notlong4
	move.w	(sp)+,-(a0)	; transport the (zero) frame word

notlong4:
	move.l	d1,-(a0)	; transport the return address
.endc
	ori.w	#$2000,d0	; set supervisor mode
	move.w	d0,-(a0)	; push SR
	move.l	sp,d0		; set return value (old SSP)
	move.l	a0,sp		; set new SSP
	rte			; and everything is cool

* Super call from supervisor mode

x20_sup:
.ifeq JUST_LONG
	tst.w	_longframe	; long frames?
	beq.b	notlong5	; no...
.endc
	move.l	$a(sp),d1	; get parameter (long form)
	beq.b	xs_0		; handle Super(0L) from super mode
	subq.l	#1,d1
	beq.b	x20_inq		; handle Super(1L); (inquiry)
	move.l	$a(sp),a1	; get parm
	move.w	(sp)+,d0	; get SR
	move.l	(sp)+,d1	; get PC
	move.w	(sp)+,-(a1)	; transport (zero) frame word
	move.l	d1,-(a1)	; push PC

.ifeq JUST_LONG
	bra.b	temp2		; finish up here

notlong5:
	move.l	8(sp),d1	; get parameter
	beq.b	xs_0		; go handle Super(0L) from super mode
	subq.l	#1,d1		; check for Super(1L)
	beq.b	x20_inq		; go handle Super(1L) (inquiry)

	move.l	8(sp),a1	; point to new SSP
	move.w	(sp)+,d0	; pop SR
	move.l	(sp)+,-(a1)	; transport the return address
temp2:
.endc
	move.w	d0,-(a1)	; finish up here: push SR
	move.l	usp,a0		; get USP
	cmpa.l	a0,sp		; already at old USP?
	beq.b	xs_usp		; don't play with stack

	move.l	(sp)+,-(a0)	; transport func # and parm
	move.l	a1,sp		; update SSP
	bra.b	xs_exit

xs_usp:
	move.l	a1,sp		; update SSP
	bra.b	xs_scram

* xs_0: handle Super(0L) from Super mode: go to USER mode with USP = SSP
xs_0:
.ifeq JUST_LONG
	lea.l	6(sp),a0	; create USP (preload for short frames)
	tst.w	_longframe
	beq	xs_1
.endc
	lea.l	8(sp),a0	; create USP for long frames
xs_1:

xs_exit:
	move.l	a0,usp		; update USP
xs_scram:
	andi.w	#$DFFF,(sp)	; set user mode
	rte			; and clear out

* inquiry mode entry point

x20_inq:
	move.l	#$2000,d0	; set up test mask
	and.w	(sp),d0		; check the supervisor state
	beq.b	xi_exit		; return 0L for user mode

	moveq.l	#-1,d0		; return -1L for sup mode
xi_exit:
	rte


*
* call dosjr from within itself (or from linked-in shell)
*
_oscall:
	link	a6,#0
	move.l	a0,-(sp)
	lea	8(a6),a0
	move.l	a0,-(sp)
	jsr	_osif
	addq.l	#4,sp
	move.l	(sp)+,a0
	unlk	a6
	rts

*----------------
*
*  Bring GEMDOS up to date with the BIOS's idea
*  (which is a real-time clock chip if there's one installed in the system)
*  (Note: before 7/89, this jsr'ed directly into BIOS; now it traps.)
*
	.globl	_clksync			; (export)
	.globl	_date,_time			; (import)

_clksync:
	move.w	#$17,-(sp)		; Gettime XBIOS call
	trap	#$e
	addq.l	#2,sp
	move.w	sr,d1			; save IPL
	or.w	#$0700,sr		; disable interrupts
	move.w	d0,_time		;;<7> set time
	swap	d0			;;<7>
	move.w	d0,_date		;;<7> set date
	move.w	d1,sr			;;<7> re-enable interrupts
	rts


*----------------
*
*  Update BIOS clock from GEMDOS's idea of the time
*  (called by the settime/setdate functions)
*
	.globl	_upd_tod
_upd_tod:
	move.w	_time,-(sp)		; time in low word
	move.w	_date,-(sp)		; date in high word
	move.w	#$16,-(sp)		; Settime(date << 16 | time)
	trap	#14
	addq	#6,sp			; cleanup and return
	rts


* lmul.s

*------------------------------------------------------------------------
*									:
*	Long Multiply							:
*	(C)1986 Atari Corp.						:
*									:
*---- edit history (reverse order, please)				:
*									:
* 17-Jan-1986 lmd	Cleaned-up DRI source code.  It could use one	:
*			more sweep to clean up stupid compiled code.	:
*									:
*------------------------------------------------------------------------


*
*  SYNOPSIS
*    DOUBLE_REG lmul(long1, long2)
*    long long1, long2;
*
*    Returns long value in D0 and D1.  No overflow checking.
*
*  ---- editorial ----
*  The actual origin of this code may be forever lost in the mists
*  of history.  It /appears/ to be hacked-up assembly output from
*  the Alcyon `C' compiler.  Surely no human would write something
*  like this.  It /had/ to be someone from DRI ....
*  -------------------
*

	.text
	.globl	lmul
*
lmul:
	link	a6,#-4		; git us some stack space, bartender
	clr	d2		; zap sign flag
	tst.l	8(a6)		; is first argument negative?
	bge.b	L2		; (nope)
	neg.l	8(a6)		; yes, negate it
	addq.w	#1,d2		; increment sign flag
L2:	tst.l	12(a6)		; is second argument negative?
	bge.b	L3		; (nope)
	neg.l	12(a6)		; yes, make it positive
	addq.w	#1,d2		; increment sign flag
L3:	move	10(a6),d0	; D0 = arg1.low * arg2.low
	mulu	14(a6),d0
	move.l	d0,-4(a6)
	move	8(a6),d0	; D0 = arg1.hi * arg2.low
	mulu	14(a6),d0
	move	12(a6),d1	; D1 = arg2.hi * arg1.low
	mulu	10(a6),d1
	add	d1,d0		; D0 = arg1.hi*arg2.low + arg2.hi*arg1.low
	add	-4(a6),d0	; D0 += arg1.low * arg2.low (from temp)
	move	d0,-4(a6)	; store back in temp hiword
	move.l	-4(a6),d0	; long results [what a stupid compiler]
	btst	#0,d2		; test sign flag
	beq.b	L4		; (even -- signs evened out)
	neg.l	d0		; odd - negate result
L4:	unlk	a6		; cleanup stack and return
	rts


*
* DRI ldiv code -- could be cleaned up (a lot) or rewritten
*
* mac-incompatible lines removed/edited 3/88 AKP
*

	.comm	_ldivr,4
	.globl	_ldiv
	.globl	ldiv
	.text
_ldiv:
ldiv:
	link	a6,#-2
	movem.l	d2-d7,-(sp)
	clr	d3
	clr.l	d5
	move.l	8(a6),d7
	move.l	12(a6),d6
	bne	xL2
	move.l	#$80000000,_ldivr
	move.l	#$80000000,d0
	divs	#0,d0		; *<<<<< div by zero trap   whf 3/7/84
	bra.b	xL1
xL2:
	bge.b	xL3
	neg.l	d6
	addq	#1,d3
xL3:
	tst.l	d7
	bge.b	xL4
	neg.l	d7
	addq	#1,d3
xL4:
	cmp.l	d7,d6
	bgt.b	xL6
	bne.b	xL7
	move.l	#1,d5
	clr.l	d7
	bra.b	xL6
xL7:
	cmp.l	#$10000,d7
	bge.b	xL9
	divu	d6,d7
	move	d7,d5
	swap	d7
	ext.l	d7
	bra.b	xL6
xL9:
	move.l	#1,d4
xL12:
	cmp.l	d6,d7
	blo.b	xL11
	asl.l	#1,d6
	asl.l	#1,d4
	bra.b	xL12
xL11:
	tst.l	d4
	beq.b	xL6
	cmp.l	d6,d7
	blo.b	xL15
	or.l	d4,d5
	sub.l	d6,d7
xL15:
	lsr.l	#1,d4
	lsr.l	#1,d6
	bra.b	xL11
xL6:
	cmp	#1,d3
	bne.b	xL16
	neg.l	d7
	move.l	d7,_ldivr
	move.l	d5,d0
	neg.l	d0
	bra.b	xL1
xL16:
	move.l	d7,_ldivr
	move.l	d5,d0
xL1:
	addq.l	#4,sp
	movem.l	(sp)+,d3-d7
	unlk	a6
	rts

*
* usr2xfr(n,d,s)
* xfr2usr(n,s,d) (note argument ordering)
*
* Copy n bytes from s to d.  N can be odd, and s or d can be odd, but 
* not usually.
*

.globl _usr2xfr
.globl _xfr2usr

_usr2xfr:
	move.l	$6(sp),a1
	move.l	$a(sp),a0	; a0 is source
	bra.b	doxfr

_xfr2usr:
	move.l	$6(sp),a0
	move.l	$a(sp),a1

doxfr:	move.w	4(sp),d0	; d0 is count

	btst	#0,d0		; if count is odd or either addr is odd,
	bne.b	odd		; then use a byte move.
	move.w	a0,d1
	move.w	a1,d2		; (This would be "or.w a1,d1" but the
	or.w	d2,d1		; 68000 doesn't allow that.)
	btst	#0,d1
	bne.b	odd

* use a word or long move.
* We branch to end of dbra loop in case count is zero.

	move.w	d0,d1
	asr.w	#2,d1
	bra.b	ewloop
wloop:	move.l	(a0)+,(a1)+
ewloop:	dbra	d1,wloop
	and.w	#3,d0		; do the trailing word if any
	beq.b	done
	move.w	(a0)+,(a1)+
done:	rts

bloop:	move.b	(a0)+,(a1)+
odd:	dbra	d0,bloop
	rts

	.data

	.even
fsstak:	dc.l	fstrt

	.bss
	.even
bssstrt:	ds.w	1
biosav:		ds.l	1
saveret:	ds.l	1
savesr:		ds.w	1
retshell:	ds.l	1
regsav:		ds.l	16
		ds.w	1000
fstrt:		ds.l	1
otime:		ds.l	1
obdos:		ds.l	1

    .end
