# TOS 2.07 build, run by C:\AUTO\RUNNER.PRG at boot (commands: build/src/runner.c).
# S: is the repository, D: the work copy, M: the RAM disk.
# BIOS: the Atari BIOS of 1992-02-29 (makefile 2.15, Sparrow/USA ROM objects).
# VDI, GEMDOS (bdos), AES, desktop: the TOS 2.06 sources; every module is compiled as the tos3x build
# does it, with the original Alcyon tools; CP68 takes one include directory: D:\COMMON\.
# D:\ROM\TOS.IMG must be TOS 2.07 byte for byte (EXPECT.LST, from TOS.LST).

echo copy the sources to D:
rmtree D:\
rmtree M:\
cptree S:\BIOS D:\BIOS
# the 2.07 ROM waits in a delay loop before it reads SPAR_CONF; no startup.s revision has the loop
# (a working-file edit between 2.92 and 2.93), so the job adds it
subst D:\BIOS\STARTUP.S \tmoveq\t#0,d1\r\n\tmove.b\tSPAR_CONF,d0 \tmove.w\t#3,d0\r\n\tmove.w\t#-1,d1\r\nspdelay:\r\n\tdbra\td1,spdelay\r\n\tdbra\td0,spdelay\r\n\tmoveq\t#0,d1\r\n\tmove.b\tSPAR_CONF,d0
# makefile 2.15 assembles m68030.s (M68030 equ 1), which no revision holds
copy C:\SPARROW\M68030.S D:\BIOS\M68030.S
cptree S:\COMMON D:\COMMON
cptree S:\VDI D:\VDI
cptree S:\BDOS D:\BDOS
cptree S:\AES D:\AES
cptree S:\DESK D:\DESK
cptree C:\ROM D:\ROM
copy C:\SLAV\AS68SYMB.DAT M:\AS68SYMB.DAT

echo BIOS (Lattice make, makefile 2.15)
setenv PATH=C:\LC\BIN;C:\SLAV;C:\BIN;C:\UTIL
echo the surviving MAS versions reject clr.l An; tos207.rom holds suba.l An,An there
subst D:\BIOS\STARTUP.S clr.l\ta5 suba.l\ta5,a5
subst D:\BIOS\STARTUP.S clr.l\ta0 suba.l\ta0,a0
subst D:\BIOS\XINOUT.S clr.l\ta5 suba.l\ta5,a5
echo the makefile names the AS68 symbol file c:\alcyon\lib\oas68sym.dat; here it is M:\AS68SYMB.DAT
subst D:\BIOS\MAKEFILE c:\\alcyon\\lib\\oas68sym.dat M:\\
echo HiSoft make applies the .c.o rule of makefile 2.15 only with a .SUFFIXES line
subst D:\BIOS\MAKEFILE \r\n.c.o: \r\n.SUFFIXES:\s.o\s.c\r\n.c.o:
cd D:\BIOS
echo one target per make call: the runner command line is short
x make startup.wo
x make dmaread.w
x make clock.w
x make bios.wu
x make flop.w
x make prtblk.o
x make rwabs.o
x make xinout.o
x make memtest.o
x mac version.s

setenv PATH=C:\BIN;C:\SLAV;C:\UTIL

echo VDI
cd D:\VDI
x C:\BIN\CP68.TTP -P -I D:\COMMON\ escape.s escape.i
x C:\BIN\AS68.TTP -u -l -s M:\ -f M:\ escape.i
del escape.i
