global mfp ; alias stmfp 'xmfp fffffa00' ; alias ttmfp 'xmfp fffffa80' ; stmfp

procedure gpip arg
  if `argc 's(+ `mfp 01) `arg;goto done'
  print -x02 (peek (+ `mfp 01))
#:done
.
