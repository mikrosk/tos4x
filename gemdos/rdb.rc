load c:\apratt\rdb.rc

set eightbit 0
bind "echo \e8s\r" 1d ; # ^] bury window, Mint/MGR style
load fs.db

alias xskip "b #f (lpeek `sp);g"

getsym dos.sys (+ `stubbp 11c)
load bios.db
b#8 ._trap13 ; alias br8 "_db13 (+ `sp 4);_13enter"
b#9 (- ._trap14 2); alias br9 "if `bios_ret print BIOS returns `d0;_13leave"

alias _c defer g

alias dblev "sl.__dblev"

echo say "dblev X" to set db level to X.
echo Levels: 1=top level, 2=rwabs/getrec, 4=xrw and clusters, 8=handles
echo 10=pool, 20=dirnext, 40=pexec
dblev 1
