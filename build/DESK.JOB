# DESK.PRG (the desktop as a program) from multitos/makedesk, run by C:\AUTO\RUNNER.PRG at boot
# (commands: build/src/runner.c). S: is the repository, D: the work copy. aesbin73 and the glue as in
# GEMSYS.JOB, apstart.oo from apstart.s (AS68), then makedesk with Lattice 5.52, one make call per object.
echo copy the sources to D:
rmtree D:\
cptree S:\MULTITOS D:\MULTITOS
setenv PATH=C:\UTIL;C:\LC\BIN;C:\SLAV
echo AES binding library aesbin73: Alcyon C (cp68, c068 -f, c168) and MadMac 1.05 (mac -6) per member;
echo the lost assembler of the original members made addq/moveq of these add/move forms (subst)
cd D:\MULTITOS\AESBIND
x C:\BIN\CP68.TTP -I D:\MULTITOS\AESBIND\ header.c header.i
x C:\BIN\C068.TTP header.i header.1 header.2 header.3 -f
x C:\BIN\C168.TTP header.1 header.2 header.s
subst header.s add\s#1, addq\s#1,
subst header.s add.l\s#1, addq.l\s#1,
subst header.s move\s#1,R0 moveq\s#1,R0
x C:\SLAV\MAC.PRG -6 header.s
x C:\BIN\CP68.TTP -I D:\MULTITOS\AESBIND\ apexit.c apexit.i
