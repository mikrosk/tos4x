exec off
set eightbit 0
bind "echo \e8s\r" 1d ; # ^] bury window, Mint/MGR style
load c:\apratt\db.rc
load fs.db

alias a "dw`sp[f]"

load bios.db
b#8 .trap13 ; alias br8 "_db13 (+ `sp 4);_13enter"
b#9 (- .trap14 2); alias br9 "if `bios_ret print BIOS returns `d0;_13leave"

# this alias is used in DBCMDs in the source

alias _c defer g

alias dblev "sl.__dblev"

print say "dblev X" to set db level to X.
print Levels: 1=top level, 2=rwabs/getrec, 4=xrw and clusters, 8=handles

dblev 1

