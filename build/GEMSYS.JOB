echo link with the MultiTOS ALN: ab.lnk once, then for each language its glue, gem.lnk, strip the
echo symbol table and prgflags (it waits for Return)
x C:\MTOS\ALN.TOS -c ab.lnk

echo English: glue.usa with NEWGLUE.PRG, one session ita, spa, usa (the bytes newglue never writes keep the
echo previous country's glue)
type ita\rspa\rusa\rexit\r
x C:\GLUE\NEWGLUE.PRG
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_USA.SYS

echo German: glue.grm with NEWGLUE.PRG, a session of grm alone (the bytes newglue never writes stay
echo as the fresh buffer has them, zero)
type grm\rexit\r
x C:\GLUE\NEWGLUE.PRG
subst D:\MULTITOS\GEM.LNK glue.usa\s_USARSC glue.grm\s_USARSC
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_GRM.SYS

echo French: glue.fre with NEWGLUE.PRG, a session of fre alone
type fre\rexit\r
x C:\GLUE\NEWGLUE.PRG
subst D:\MULTITOS\GEM.LNK glue.grm\s_USARSC glue.fre\s_USARSC
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_FRE.SYS

echo Italian: glue.ita with NEWGLUE.PRG, a session of ita alone
type ita\rexit\r
x C:\GLUE\NEWGLUE.PRG
subst D:\MULTITOS\GEM.LNK glue.fre\s_USARSC glue.ita\s_USARSC
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_ITA.SYS

echo Spanish: glue.spa with NEWGLUE.PRG, a session of spa alone
type spa\rexit\r
x C:\GLUE\NEWGLUE.PRG
subst D:\MULTITOS\GEM.LNK glue.ita\s_USARSC glue.spa\s_USARSC
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_SPA.SYS

echo Swedish: glue.swe with NEWGLUE.PRG, a session of swe alone
type swe\rexit\r
x C:\GLUE\NEWGLUE.PRG
subst D:\MULTITOS\GEM.LNK glue.spa\s_USARSC glue.swe\s_USARSC
x C:\MTOS\ALN.TOS -c gem.lnk
x C:\SLAV\STRIP68.TOS gem.sys
key
x C:\SLAV\PRGFLAGS.TTP 7 7 gem.sys
copy D:\MULTITOS\GEM.SYS D:\MULTITOS\GEM_SWE.SYS

del D:\MULTITOS\GEM.SYS

echo compare with the expected checksums
check C:\EXPECT.LST
